{
  "name": "Mostamskaty — Arabic desktop",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "remoteUser": "vscode",
  "containerEnv": { "VNC_RESOLUTION": "1600x1080x24" },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Mostamskaty Desktop",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash scripts/setup_codespaces.sh",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
